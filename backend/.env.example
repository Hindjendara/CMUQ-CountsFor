# Every environment variable the CountsFor API (backend/*.py) reads.
#
# Local development: copy this file to backend/.env (gitignored) and edit it.
#     cp backend/.env.example backend/.env
# backend/config.py loads backend/.env at import. Variables already set in the
# real environment win over it. The active lines below are local-dev values.
#
# Production does not use backend/.env. systemd loads /etc/countsfor/countsfor.env
# (template: deploy/countsfor.env.example). Each variable's production value is
# in its "Production:" comment.
#
# A line "# NAME=value" is a documented variable left unset (its default applies).
# Never put real secrets in this file. backend/tests/test_env_example.py checks
# that this list and the os.environ reads in backend/ stay identical.


# ── Mode ────────────────────────────────────────────────────────────────────
# "production" refuses to start without SECRET_KEY and DATABASE_URL (no SQLite
# fallback) and turns on Secure session cookies. Anything else is development.
# Production: FLASK_ENV=production
FLASK_ENV=development

# Signs the session cookie and the bearer auth tokens. Changing it signs
# everyone out; password hashes do not depend on it. Unset outside production
# means a fixed dev key.
# Production: a long random value, made with
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-local-dev-only


# ── Database ────────────────────────────────────────────────────────────────
# SQLAlchemy URL. A relative SQLite path lands in backend/instance/ (created if
# missing), so this is backend/instance/countsfor.db. postgres:// is accepted
# and rewritten to postgresql://.
# Production: DATABASE_URL=postgresql:///countsfor
#   (local PostgreSQL over the Unix socket, peer auth as the countsfor OS user;
#   or postgresql://countsfor:PASSWORD@127.0.0.1:5432/countsfor)
DATABASE_URL=sqlite:///countsfor.db

# 1 = create_app() skips create_all() and migrations at startup. Unset locally,
# so `python -m backend.app` keeps the local database up to date.
# Production: SKIP_DB_BOOTSTRAP=1 (systemd runs `python -m backend.bootstrap_db`
#   once before gunicorn starts, so the workers do not race on migrations)
# SKIP_DB_BOOTSTRAP=1


# ── Session cookie and proxy ────────────────────────────────────────────────
# The site and the API share one origin, so the session cookie is first-party.
# Secure (sent over HTTPS only): default on in production, off otherwise (local
# dev is plain http). Accepts 1/0, true/false.
# Production: unset (on)
# SESSION_COOKIE_SECURE=0

# Lax (default), Strict or None. None also needs Secure, and is only for a
# frontend on another site.
# Production: unset (Lax)
# SESSION_COOKIE_SAMESITE=Lax

# 1 = trust the X-Forwarded-For and X-Forwarded-Proto headers of the one proxy in
# front (werkzeug ProxyFix), so request.remote_addr is the real client. Only set
# it when the app is reachable through that proxy alone.
# Production: TRUST_PROXY=1 (Apache in front, gunicorn bound to 127.0.0.1)
# TRUST_PROXY=0


# ── Sign-in ─────────────────────────────────────────────────────────────────
# Google OAuth web client ID used to verify Google ID tokens. Public, not a
# secret. Must equal the cf-google-client-id meta tag in frontend/index.html and
# frontend/app.html. Empty locally makes "Continue with Google" fail with
# "GOOGLE_CLIENT_ID not set on the server"; password sign-in still works.
# Production: the same value
GOOGLE_CLIENT_ID=378923997481-bgnvhg3gsgka5ptijjjsb80q4k7kc2vg.apps.googleusercontent.com

# Only this email domain may sign in. Empty allows any CMU address
# (cmu.edu and qatar.cmu.edu are rewritten to andrew.cmu.edu anyway).
# Production: andrew.cmu.edu
ALLOWED_EMAIL_DOMAIN=andrew.cmu.edu

# Faculty directory seed (JSON). Default backend/seed_users.json (gitignored,
# for a private local seed). If that file is missing the app falls back to
# backend/data/faculty_directory.json. A relative path is tried against the
# working directory, backend/ and the repo root.
# Production: /var/www/html/countsfor/backend/data/faculty_directory.json
# SEED_USERS_PATH=backend/seed_users.json

# Hand-kept admin list layered over the seed. Unset means
# backend/data/directory_admins.json; an empty value disables it.
# Production: unset
# ADMIN_SEED_PATH=backend/data/directory_admins.json


# ── Course data ─────────────────────────────────────────────────────────────
# The private SOC scrape. The admin overview shows its last_scrape date. The
# scraper (backend/scraper/) reads the same variable.
# Production: unset (backend/data/soc.json), or the absolute path
#   /var/www/html/countsfor/backend/data/soc.json
# SOC_JSON_PATH=backend/data/soc.json


# ── Password reset ──────────────────────────────────────────────────────────
# Lifetime of a reset link, in minutes.
RESET_TOKEN_MINUTES=30

# The page reset emails link to (the landing page); ?token=... is appended.
# Default: the first FRONTEND_ORIGIN + /index.html.
# Production: https://countsfor.qatar.cmu.edu/index.html
FRONTEND_RESET_BASE=http://localhost:8765/index.html

# Local dev only: 1 = /api/auth/forgot-password returns the reset link in its
# response, so resets work without email. Never set it in production.
EXPOSE_RESET_TOKEN=1

# Email for reset links: configure one provider, or none (then the forgot view
# steers users to "Continue with Google"). Resend is tried first.
#
# Resend: needs RESEND_API_KEY and MAIL_FROM. Secret.
# RESEND_API_KEY=
#
# Sender for either provider. Quote values with spaces or < >.
# MAIL_FROM="CountsFor <noreply@example.edu>"
#
# SMTP: needs SMTP_HOST plus a sender (MAIL_FROM, or SMTP_USER as the From
# address). SMTP_USER and SMTP_PASS are optional: without SMTP_USER no login is
# attempted, which suits an unauthenticated campus relay.
# Production: whatever CMU-Q IT provides, e.g. a relay host with MAIL_FROM set
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# STARTTLS after connecting (default true). Set false for a relay without TLS.
# SMTP_USE_TLS=true


# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated origins (no path, no trailing slash) allowed to call /api from
# another origin. The site itself calls the API on its own origin and never
# needs this; it matters only for a page on another origin, e.g. one using the
# cf_backend_override debugging hook in js/api.js.
# Production: https://countsfor.qatar.cmu.edu
FRONTEND_ORIGIN=http://localhost:8765


# ── Dev server (python -m backend.app only; gunicorn ignores these) ─────────
# Bind address and port. Not 5000: macOS AirPlay Receiver uses it.
# scripts/dev_server.py proxies /api to 127.0.0.1:5050 by default.
HOST=127.0.0.1
PORT=5050
# Flask debug mode (reloader, tracebacks). Default 1.
FLASK_DEBUG=1
