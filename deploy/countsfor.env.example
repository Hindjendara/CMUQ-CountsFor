# Template for /etc/countsfor/countsfor.env on the server: the CountsFor API's
# environment, loaded by systemd (EnvironmentFile= in countsfor-api.service).
#
#   sudo install -d -m 750 -o root -g countsfor /etc/countsfor
#   sudo install -m 640 -o root -g countsfor deploy/countsfor.env.example /etc/countsfor/countsfor.env
#   sudo editor /etc/countsfor/countsfor.env      # replace every CHANGE_ME
#
# One NAME=value per line, no "export". Double-quote a value that contains
# spaces or < > (systemd and bash both accept that). Real secrets live only in
# /etc/countsfor/, never in the repo and never in backend/.env on the server
# (that folder sits under /var/www/html).
#
# Every variable is explained in backend/.env.example. Variables not listed here
# keep their defaults. backend/tests/test_env_example.py checks that each name
# here is one the API reads.

FLASK_ENV=production

# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME

# Local PostgreSQL over the Unix socket, peer auth (OS user countsfor = DB role countsfor):
DATABASE_URL=postgresql:///countsfor
# or with a password over TCP:
# DATABASE_URL=postgresql://countsfor:CHANGE_ME@127.0.0.1:5432/countsfor

# systemd runs `python -m backend.bootstrap_db` before gunicorn (ExecStartPre).
SKIP_DB_BOOTSTRAP=1

# Apache is the only way in (gunicorn listens on 127.0.0.1:8000).
TRUST_PROXY=1
# Session cookie: defaults are right for production (Secure, SameSite=Lax).
# SESSION_COOKIE_SECURE=1
# SESSION_COOKIE_SAMESITE=Lax

# Public OAuth client ID; must equal the cf-google-client-id meta in the HTML.
GOOGLE_CLIENT_ID=378923997481-bgnvhg3gsgka5ptijjjsb80q4k7kc2vg.apps.googleusercontent.com
ALLOWED_EMAIL_DOMAIN=andrew.cmu.edu

SEED_USERS_PATH=/var/www/html/countsfor/backend/data/faculty_directory.json
# ADMIN_SEED_PATH=/var/www/html/countsfor/backend/data/directory_admins.json
SOC_JSON_PATH=/var/www/html/countsfor/backend/data/soc.json

FRONTEND_ORIGIN=https://countsfor.qatar.cmu.edu
FRONTEND_RESET_BASE=https://countsfor.qatar.cmu.edu/index.html
# RESET_TOKEN_MINUTES=30

# Password-reset email: one provider, or none (users then recover with Google).
# Campus SMTP relay (no login needed: leave SMTP_USER and SMTP_PASS unset):
# SMTP_HOST=CHANGE_ME
# SMTP_PORT=25
# SMTP_USE_TLS=false
# MAIL_FROM="CountsFor <CHANGE_ME@qatar.cmu.edu>"
# Authenticated SMTP adds:
# SMTP_USER=CHANGE_ME
# SMTP_PASS=CHANGE_ME
# Or Resend (needs outbound HTTPS to api.resend.com):
# RESEND_API_KEY=CHANGE_ME

# Outbound proxy, only if the server has no direct internet. Read by the
# requests library (Google certificate fetch, Resend), not by CountsFor code.
# HTTPS_PROXY=http://CHANGE_ME:3128
