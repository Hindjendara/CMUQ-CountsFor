# Template for /etc/countsfor/scraper.env on the server: the environment of the
# daily data pipeline (backend/scraper/). The cron job runs
# backend/scraper/run_scrape.sh, which sources this file and runs update_data.py.
#
# The pipeline needs no secrets and no database: it only reads the public
# Schedule of Classes and reads and writes JSON files. Every path defaults to
# the folder layout the scripts sit in (backend/scraper/pipeline_paths.py), which
# on the server is already right, so everything below is optional.
# backend/tests/test_env_example.py checks that each name here is one the
# pipeline reads, and that every variable it reads is listed here.

# ── Daily update (update_data.py) ───────────────────────────────────────────
# The deploy root: the live files are <root>/backend/data/soc.json and
# <root>/frontend/data/courses.json (default: the folder that holds backend/).
# CF_DEPLOY_ROOT=/var/www/html/countsfor
# Where the pipeline works on copies before they go live (default
# <root>/backend/var/staging). Keep it outside the DocumentRoot.
# CF_STAGING_DIR=/var/www/html/countsfor/backend/var/staging
# Refuse to publish if any campus of a semester loses sections below this
# fraction of the live soc.json (default 0.98).
# CF_MIN_SECTION_RATIO=0.98
# Refuse to publish if the catalog falls below this fraction of the live
# course count (default 0.95). Losing any course code always fails.
# CF_MIN_CATALOG_RATIO=0.95

# ── Files (when a script is run by hand) ─────────────────────────────────────
# update_data.py sets these four to its staged copies for every step, so they
# have no effect on the cron job.
# Where scrape_soc.py writes the scrape (default backend/data/soc.json).
# SOC_OUTPUT_PATH=/var/www/html/countsfor/backend/data/soc.json
# Where reconcile_offerings.py and validate_soc_coverage.py read it. The API's
# admin overview reads the same variable (deploy/countsfor.env.example).
# SOC_JSON_PATH=/var/www/html/countsfor/backend/data/soc.json
# The served catalog (default frontend/data/courses.json).
# COURSES_JSON_PATH=/var/www/html/countsfor/frontend/data/courses.json
# Semicolon-separated catalogs apply_mapping_overlays.py patches (default: the one above).
# CATALOG_PATHS=/var/www/html/countsfor/frontend/data/courses.json
# Qatar mapping overlays (default backend/data/mapping_overlays.json). Unlike the
# four above, update_data.py keeps this one (its default: <root>/backend/data/).
# MAPPING_OVERLAYS_PATH=/var/www/html/countsfor/backend/data/mapping_overlays.json

# ── Scrape ──────────────────────────────────────────────────────────────────
# Schedule of Classes servlet (needs outbound HTTPS to enr-apps.as.cmu.edu).
# SOC_BASE_URL=https://enr-apps.as.cmu.edu/open/SOC/SOCServlet
# A fall or spring semester with fewer courses counts as not released yet, and
# its previous data is kept.
# MIN_COURSES_FOR_VALID_SCRAPE=100
# The same for summer semesters, which list far fewer courses.
# MIN_COURSES_FOR_SUMMER_SCRAPE=10
# Comma-separated semester codes instead of the list on the SOC form, e.g. F26,S27.
# SEMESTERS_TO_TRY=F26,S27

# Outbound proxy, only if the server has no direct internet (Python's urllib
# reads it; not a CountsFor variable).
# https_proxy=http://CHANGE_ME:3128
