<!--
  Attribute map for CountsFor: which SAML attributes the SP keeps, and the id
  (the request header name, with ShibUseHeaders On in deploy/countsfor.conf)
  each one gets.

  Installed as /etc/shibboleth/attribute-map.xml (README 15.22):
    sudo cp /etc/shibboleth/attribute-map.xml /etc/shibboleth/attribute-map.xml.dist
    sudo install -m 644 deploy/shibboleth/attribute-map.xml /etc/shibboleth/attribute-map.xml
    sudo shibd -t && sudo systemctl restart shibd

  What CountsFor reads (backend/auth.py, header names set in backend/config.py):
    eppn         eduPersonPrincipalName, andrewid@andrew.cmu.edu. The identity.
    mail         used only when the IdP releases no eppn
    displayName  the name shown in the app
    givenName, sn  the name when there is no displayName
  Ask IT to release eppn, mail, displayName, givenName and sn. The affiliation
  attributes are mapped for testing and later use (student, faculty, staff);
  CountsFor does not read them today: roles come from its own directory.

  An attribute the IdP sends but this file does not list is dropped. The
  package's attribute-policy.xml accepts an eppn only when its scope
  (andrew.cmu.edu) is listed for the IdP in its metadata; if /Shibboleth.sso/Session
  shows mail but no eppn, that check is the first thing to look at.
-->
<Attributes xmlns="urn:mace:shibboleth:2.0:attribute-map"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <!-- eduPersonPrincipalName -->
    <Attribute name="urn:oid:1.3.6.1.4.1.5923.1.1.1.6" id="eppn">
        <AttributeDecoder xsi:type="ScopedAttributeDecoder"/>
    </Attribute>

    <!-- mail -->
    <Attribute name="urn:oid:0.9.2342.19200300.100.1.3" id="mail"/>

    <!-- displayName -->
    <Attribute name="urn:oid:2.16.840.1.113730.3.1.241" id="displayName"/>

    <!-- givenName -->
    <Attribute name="urn:oid:2.5.4.42" id="givenName"/>

    <!-- sn (surname) -->
    <Attribute name="urn:oid:2.5.4.4" id="sn"/>

    <!-- eduPersonScopedAffiliation (student@andrew.cmu.edu ...) -->
    <Attribute name="urn:oid:1.3.6.1.4.1.5923.1.1.1.9" id="affiliation">
        <AttributeDecoder xsi:type="ScopedAttributeDecoder" caseSensitive="false"/>
    </Attribute>

    <!-- eduPersonAffiliation (student, faculty, staff, member ...) -->
    <Attribute name="urn:oid:1.3.6.1.4.1.5923.1.1.1.1" id="unscoped-affiliation">
        <AttributeDecoder xsi:type="StringAttributeDecoder" caseSensitive="false"/>
    </Attribute>

</Attributes>
