<!--
  Shibboleth SP configuration for CountsFor (Shibboleth SP 3, the Ubuntu 24.04
  packages libapache2-mod-shib and shibboleth-sp-utils).

  Installed as /etc/shibboleth/shibboleth2.xml (README 15.22):
    sudo cp /etc/shibboleth/shibboleth2.xml /etc/shibboleth/shibboleth2.xml.dist
    sudo install -m 644 deploy/shibboleth/shibboleth2.xml /etc/shibboleth/shibboleth2.xml
    sudo shibd -t && sudo systemctl restart shibd

  Every CHANGE_ME is a value CMU IT must confirm or provide. The other files this
  one names (attribute-policy.xml, security-policy.xml, protocols.xml) are the
  package's own, left as installed. attribute-map.xml comes from this folder.
-->
<SPConfig xmlns="urn:mace:shibboleth:3.0:native:sp:config"
    xmlns:conf="urn:mace:shibboleth:3.0:native:sp:config"
    clockSkew="180">

    <OutOfProcess tranLogFormat="%u|%s|%IDP|%i|%ac|%t|%attr|%n|%b|%E|%S|%SS|%L|%UA|%a" />

    <!--
      entityID: this SP's name, the one IT registers with CMU's IdP.
      REMOTE_USER: eppn (andrewid@andrew.cmu.edu), shown in Apache's logs.
    -->
    <ApplicationDefaults entityID="https://countsfor.qatar.cmu.edu/shibboleth"
        REMOTE_USER="eppn"
        cipherSuites="DEFAULT:!EXP:!LOW:!aNULL:!eNULL:!DES:!IDEA:!SEED:!RC4:!3DES:!kRSA:!SSLv2:!SSLv3:!TLSv1:!TLSv1.1">

        <!--
          handlerURL: the SP's endpoints, under https://countsfor.qatar.cmu.edu/Shibboleth.sso/
            Metadata     this SP's metadata, for IT
            SAML2/POST   the assertion consumer service (ACS) the IdP posts to
            Session      who is signed in, for testing
            Logout       ends the SP session (CountsFor's sign out goes here)
          handlerSSL, cookieProps="https": HTTPS only, Secure cookies.
          redirectLimit="exact": after sign-in or Logout?return=, the SP only
            redirects to this same scheme and host (no open redirect).
          checkAddress="false": campus NAT and phones change addresses.
          lifetime 8 h, timeout 1 h: the SP session only matters at sign-in;
            CountsFor keeps its own session after that.
        -->
        <Sessions lifetime="28800" timeout="3600" relayState="ss:mem"
                  checkAddress="false" handlerURL="/Shibboleth.sso" handlerSSL="true"
                  cookieProps="https" redirectLimit="exact">

            <!-- CHANGE_ME (IT to confirm): CMU's IdP entityID. -->
            <SSO entityID="https://login.cmu.edu/idp/shibboleth">
              SAML2
            </SSO>

            <!-- SAML2 single logout when the IdP offers it, else a local logout. -->
            <Logout>SAML2 Local</Logout>

            <!-- Administrative logout, from the server only. -->
            <LogoutInitiator type="Admin" Location="/Logout/Admin" acl="127.0.0.1 ::1" />

            <!-- https://countsfor.qatar.cmu.edu/Shibboleth.sso/Metadata -->
            <Handler type="MetadataGenerator" Location="/Metadata" signing="false"/>

            <!-- From the server only: curl -sk https://localhost/Shibboleth.sso/Status -->
            <Handler type="Status" Location="/Status" acl="127.0.0.1 ::1"/>

            <!-- Lists the attributes received, names only. Set showAttributeValues="true"
                 for a test if needed, then set it back. -->
            <Handler type="Session" Location="/Session" showAttributeValues="false"/>

            <Handler type="DiscoveryFeed" Location="/DiscoFeed"/>
        </Sessions>

        <!-- CHANGE_ME: the address shown on the SP's error pages. -->
        <Errors supportContact="CHANGE_ME@qatar.cmu.edu" helpLocation="/"/>

        <!--
          CHANGE_ME (IT to provide): where the SP reads CMU's IdP metadata.
          Default here: a file IT hands over, copied to
          /etc/shibboleth/cmu-idp-metadata.xml.
        -->
        <MetadataProvider type="XML" validate="true" path="cmu-idp-metadata.xml"/>

        <!--
          Or, if IT says to fetch it from a URL (with the certificate that signs it):
        <MetadataProvider type="XML" validate="true"
              url="https://CHANGE_ME/idp-metadata.xml"
              backingFilePath="cmu-idp-metadata.xml" maxRefreshDelay="7200">
            <MetadataFilter type="Signature" certificate="CHANGE_ME-metadata-signing.pem"/>
        </MetadataProvider>

          Or, if CountsFor is registered through InCommon (download
          https://md.incommon.org/certs/inc-md-cert-mdq.pem to /etc/shibboleth/ first):
        <MetadataProvider type="MDQ" id="incommon" ignoreTransport="true"
              cacheDirectory="incommon" baseUrl="https://mdq.incommon.org/">
            <MetadataFilter type="Signature" certificate="inc-md-cert-mdq.pem"/>
            <MetadataFilter type="RequireValidUntil" maxValidityInterval="1209600"/>
        </MetadataProvider>
        -->

        <!-- Attribute names (attribute-map.xml in this folder) and the package's
             default release policy, which checks eppn's scope against the
             IdP metadata. -->
        <AttributeExtractor type="XML" validate="true" reloadChanges="false" path="attribute-map.xml"/>
        <AttributeFilter type="XML" validate="true" path="attribute-policy.xml"/>

        <!-- Made with shib-keygen (README 15.22): one pair signs, one decrypts. -->
        <CredentialResolver type="File" use="signing"
            key="sp-signing-key.pem" certificate="sp-signing-cert.pem"/>
        <CredentialResolver type="File" use="encryption"
            key="sp-encrypt-key.pem" certificate="sp-encrypt-cert.pem"/>

    </ApplicationDefaults>

    <SecurityPolicyProvider type="XML" validate="true" path="security-policy.xml"/>
    <ProtocolProvider type="XML" validate="true" reloadChanges="false" path="protocols.xml"/>

</SPConfig>
